# --- OddsPapi ---
# Get your key at https://oddspapi.io (free tier, no card required)
ODDSPAPI_KEY=your_oddspapi_key_here

# --- Telegram ---
# 1. Message @BotFather in Telegram, send /newbot, follow the prompts -> you get a token
# 2. Message your new bot once (anything), then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the "chat":{"id": ...} value -> that's your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Alert threshold ---
# Minimum % change in odds between polls to trigger an alert (e.g. 0.08 = 8%)
SPIKE_THRESHOLD_PCT=0.08
