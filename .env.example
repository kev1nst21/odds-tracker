# --- The Odds API (the-odds-api.com) ---
# Get your key at https://the-odds-api.com/ -- paid "20K" plan ($30/mo)
# includes all bookmakers (Pinnacle, 1xBet, etc), 20,000 credits/month.
THEODDSAPI_KEY=your_theoddsapi_key_here

# Region(s) to pull odds for -- comma-separated, e.g. "eu,us". Pinnacle and
# 1xBet (our Asian/sharp reference books) both live under "eu" on this API.
THEODDSAPI_REGIONS=eu

# Market(s) to pull -- comma-separated. h2h = moneyline/1X2. Adding more
# markets multiplies quota cost per call (cost = markets x regions).
THEODDSAPI_MARKETS=h2h

# --- Telegram ---
# 1. Message @BotFather in Telegram, send /newbot, follow the prompts -> you get a token
# 2. Message your new bot once (anything), then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the "chat":{"id": ...} value -> that's your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Alert tuning ---
# Minimum % change in odds between polls to trigger an alert (e.g. 0.08 = 8%)
SPIKE_THRESHOLD_PCT=0.08
# Repeated same-direction moves within this many minutes get flagged as a "super alert"
CASCADE_WINDOW_MINUTES=30
# How long after kickoff to wait before checking a match's result
RESULT_CHECK_DELAY_HOURS=3
# How often (hours) to spend quota checking results/CLV -- scores calls cost credits too
RESULTS_CHECK_INTERVAL_HOURS=3
